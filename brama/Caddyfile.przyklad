# Caddy z bramą uwierzytelniającą przed Content AI i OpenSEO.
# Zastepuje wpisy z openseo/Caddyfile.przyklad - nie dodawaj obu naraz.
#
# W DNS potrzebne sa rekordy A dla auth., contentai. i seo. na IP serwera.
# Wszystkie musza byc poddomenami TEJ SAMEJ domeny, inaczej sesja Autheli
# nie obejmie ich razem.
#
# NIE nadpisuj /etc/caddy/Caddyfile: zrob kopie, ZASTAP bloki tych domen i dopisz
# blok globalny (patrz nizej), wpisow innych uslug nie ruszaj. Potem:
#   caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile
#   systemctl reload caddy
# Przy aktualizacji: najpierw Caddy + reload, dopiero potem git pull + restart contentai.

# ── Blok globalny: jeden, NA SAMEJ GORZE /etc/caddy/Caddyfile ────────────────
# Jesli plik ma juz blok globalny (np. od Cosmosa), dopisz do niego sekcje servers.
# Adresy Cloudflare - tylko gdy przed serwerem stoi Cloudflare z pomaranczowa chmurka;
# bez niego ten blok niczego nie zmienia. Lista: https://www.cloudflare.com/ips/
# Wymaga Caddy 2.7+ (caddy version).
{
    servers {
        trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
        client_ip_headers CF-Connecting-IP
    }
}

# ── Snippet: pytanie do bramy ────────────────────────────────────────────────
# Definiujemy raz, uzywamy w kazdej chronionej aplikacji. Dzieki temu nie da sie
# przez przeoczenie zostawic jednej bez ochrony.
(brama) {
    forward_auth 127.0.0.1:9091 {
        uri /api/authz/forward-auth
        copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
    }
}

# ── Sama brama ───────────────────────────────────────────────────────────────
# Ekran logowania. Bez forward_auth - to on jest tym ekranem.
auth.twojadomena.pl {
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        -Server
    }
    reverse_proxy 127.0.0.1:9091
}

# ── Content AI ───────────────────────────────────────────────────────────────
# Wymaga CAI_ZAUFANY_NAGLOWEK=Remote-User po stronie serwera - bez tego serwer
# zignoruje naglowek i pokaze swoj wlasny ekran logowania.
contentai.twojadomena.pl {
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        -Server
    }
    import brama
    reverse_proxy 127.0.0.1:3100 {
        # NADPISUJE naglowek od klienta: Node ufa X-Real-IP tylko od Caddy (petla zwrotna).
        # Bez tej linii limit prob logowania da sie obejsc, a wszyscy dziela jeden licznik.
        header_up X-Real-IP {client_ip}
    }
}

# ── OpenSEO ──────────────────────────────────────────────────────────────────
# Nadal port 3110 (brama Content AI), nigdy 3001 (goly kontener). Teraz sa dwie
# warstwy: Authelia sprawdza drugi skladnik, brama Content AI dokleja paletę.
seo.twojadomena.pl {
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        -Server
    }
    import brama
    reverse_proxy 127.0.0.1:3110 {
        # NADPISUJE naglowek od klienta: Node ufa X-Real-IP tylko od Caddy (petla zwrotna).
        # Bez tej linii limit prob logowania da sie obejsc, a wszyscy dziela jeden licznik.
        header_up X-Real-IP {client_ip}
    }
}

