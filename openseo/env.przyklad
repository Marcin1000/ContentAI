# OpenSEO - wzor pliku /srv/openseo/.env
#
# Powstaje z `cp .env.example .env` w katalogu OpenSEO; ponizej sa wartosci,
# ktore u nas trzeba ustawic. Reszte zostaw domyslna.
#
# UWAGA: ten plik to WZOR. Prawdziwy .env z kluczem trzymaj tylko na serwerze,
# z uprawnieniami 600, i nigdy nie commituj.

# ── DataForSEO ───────────────────────────────────────────────────────────────
# Format inny niz w Content AI: jedna zmienna, base64 z "email:haslo".
# Wygeneruj tak (podmien na swoje dane):
#   echo -n 'twoj@email.pl:twoje-haslo' | base64
# To to samo konto, ktorego uzywa Content AI - jedno saldo dla obu aplikacji.
DATAFORSEO_API_KEY=WKLEJ_WYNIK_BASE64

# ── Sieć ─────────────────────────────────────────────────────────────────────
# Port jest wiazany do 127.0.0.1 przez compose.yaml, wiec z zewnatrz niedostepny.
# Ruch wpuszcza dopiero Caddy - patrz Caddyfile.przyklad (z basicauth!).
PORT=3001

# Wymagane, gdy aplikacja stoi za reverse proxy: bez tego Vite odrzuci zadania
# z obcym naglowkiem Host.
ALLOWED_HOST=seo.twojadomena.pl

# ── Prywatnosc ───────────────────────────────────────────────────────────────
# Telemetria jest domyslnie WLACZONA. Ta zmienna ja wylacza.
OPENSEO_TELEMETRY_DISABLED=1

# ── Opcjonalne ───────────────────────────────────────────────────────────────
# Funkcje AI w samym OpenSEO (niezalezne od modeli Content AI).
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=

# Integracja z Google Search Console - wymaga wszystkich trzech naraz.
# To NIE jest logowanie do aplikacji, tylko dostep do danych GSC.
# BETTER_AUTH_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
