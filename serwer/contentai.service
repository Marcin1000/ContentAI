[Unit]
Description=Content AI - generator tresci (serwer aplikacji i proxy API)
Documentation=https://github.com/Marcin1000/ContentAI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/srv/contentai
ExecStart=/usr/bin/node /srv/contentai/serwer/server.js

# Klucze i konfiguracja - plik ma miec uprawnienia 600
EnvironmentFile=/etc/contentai/srodowisko

Restart=always
RestartSec=5

# Wlasne konto systemowe, zalozone przy instalacji:
#   sudo useradd --system --home-dir /srv/contentai --shell /usr/sbin/nologin contentai
#   sudo chown -R contentai:contentai /srv/contentai/serwer/dane
#
# Swiadomie NIE uzywamy DynamicUser=yes. Systemd nadaje wtedy uslugze zmienny
# UID i nie przejmuje na wlasnosc katalogu z ReadWritePaths - proces nie moglby
# zapisac ani sekretu sesji, ani licznikow pakietow. Serwer to przezywa po cichu
# (ostrzezenie w logu), wiec objawem byloby wylogowywanie po kazdym restarcie
# i limity, ktore nic nie licza. Stale konto usuwa cala te klase problemow.
User=contentai
Group=contentai

# Ograniczenia: usluga nie potrzebuje uprawnien roota ani dostepu do reszty systemu
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
# Jedyny katalog do zapisu: konta, sekret sesji, baza wiedzy, liczniki pakietow
ReadWritePaths=/srv/contentai/serwer/dane

StandardOutput=journal
StandardError=journal
SyslogIdentifier=contentai

[Install]
WantedBy=multi-user.target
